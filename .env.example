# =============================================================================
# VayuWise AI — Environment Variables Template
# Copy this file to .env.local for local development.
# NEVER commit .env, .env.local, or any real API keys to version control.
# =============================================================================

# Server-only Google Gemini API key (obtain from Google AI Studio)
# Note: Free-tier/unpaid Gemini API prompts/responses may be logged by Google under Gemini API Terms.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model identifier used by server-side route handlers
GEMINI_MODEL=gemini-3.1-flash-lite

# Conservative per-minute sliding-window AI route rate limit per IP (per Node isolate)
AI_RATE_LIMIT_PER_MIN=15

# Emergency AI feature toggle ("false" disables all Gemini API routes gracefully)
GEMINI_AI_ENABLED=true

# Optional public app metadata (safe for client exposure)
NEXT_PUBLIC_APP_NAME=VayuWise AI
NEXT_PUBLIC_APP_URL=http://localhost:3000
